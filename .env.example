DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=False
DJANGO_API_DOCS_ENABLED=False
DJANGO_ADMIN_URL=panel-soporte-cambiar-por-ruta-privada
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,tu-backend.up.railway.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://tu-backend.up.railway.app,https://tu-frontend.vercel.app
DJANGO_CORS_ALLOWED_ORIGINS=https://tu-frontend.vercel.app
DATABASE_URL=postgresql://usuario:password@host:5432/database
DJANGO_MEDIA_ROOT=/app/media

# A dónde mandar a quien entre por la raíz del backend con un enlace viejo.
DJANGO_FRONTEND_URL=https://tu-frontend.vercel.app

# Cache compartido. Sin esto el límite de intentos de login se cuenta por
# worker: obligatorio antes de subir WEB_CONCURRENCY por encima de 1.
REDIS_URL=redis://default:password@host:6379
